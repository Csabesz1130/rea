# Settings of rea-release-feed.service (products/vm/feed.sh reads them).
# install-service.sh copies this file to /etc/rea-release-feed.env once and
# never overwrites it. Lines are NAME=value, without quotes.

# The packages to watch. The default is the copy install-service.sh made of
# products/release-feed/watchlists/mcp-top-40.json; edit that copy.
#FEED_WATCHLIST=/var/lib/rea-feed/watchlist.json

# On first sight of a package, compare the stable release as of this day
# with the latest one. Without it, a package's first sight only records it.
#FEED_SINCE=2026-10-20

# Where the site is served, for absolute links in the feeds and alerts.
#FEED_BASE_URL=https://feed.example.com

# Alerts: a JSON POST per comparison with a finding at or above FEED_ALERT_ON
# (critical, high, medium, low, info or never). The URL is a secret: this
# file is readable by root and the rea group only.
#FEED_ALERT_ON=high
#RELEASE_FEED_WEBHOOK_URL=

# Leave the full reports, which quote lines of the packages' code, out of
# the site: set to 1.
#FEED_NO_REPORTS=

# REA Evidence to keep, in GB; the oldest goes first.
#FEED_MAX_EVIDENCE_GB=10

# How much of a large release REA examines: standard, or deep, which takes
# more time for each comparison.
#FEED_DEPTH=standard
